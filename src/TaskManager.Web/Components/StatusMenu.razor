<div class="status-menu">
    <button type="button"
            class="move-button @(Mobile ? "move-button-text" : null)"
            @ref="button"
            aria-haspopup="@(Mobile ? "dialog" : "listbox")"
            aria-expanded="@(IsOpen ? "true" : "false")"
            aria-disabled="@(IsSaving ? "true" : null)"
            aria-describedby="task-title-@TaskId"
            @onclick="ToggleAsync"
            @onkeydown="OnButtonKeyDown">
        @if (Mobile)
        {
            <span class="move-label">Move</span>
        }
        <span class="visually-hidden">Status: @BoardStatus.Label(Condition)</span>
        <Icon Name="chevron-down" />
    </button>
    @if (IsOpen && !Mobile)
    {
        <div class="status-popup" @ref="popup">
            <StatusOptions @ref="options"
                           TaskId="TaskId"
                           Condition="@Condition"
                           Tabbable="false"
                           CloseOnBlur="true"
                           OnChoose="ChooseAsync"
                           OnEscape="EscapeAsync"
                           OnBlur="CloseAsync" />
        </div>
    }
</div>

@code {
    private ElementReference button;
    private ElementReference popup;
    private StatusOptions? options;
    private bool wasOpen;
    private bool focusButton;

    [Parameter, EditorRequired] public long TaskId { get; set; }
    [Parameter, EditorRequired] public string Condition { get; set; } = "";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public bool FocusRequested { get; set; }
    [Parameter] public bool Mobile { get; set; }
    [Parameter] public IJSObjectReference? Module { get; set; }
    [Parameter] public EventCallback<long> OnOpen { get; set; }
    [Parameter] public EventCallback<long> OnClose { get; set; }
    [Parameter] public EventCallback<(long Id, string Status)> OnSelect { get; set; }
    [Parameter] public EventCallback<long> OnFocusHandled { get; set; }
    [Parameter] public EventCallback<ElementReference> OnPopupReady { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !Mobile && !wasOpen && options is not null)
        {
            wasOpen = true;
            if (Module is not null)
            {
                await Module.InvokeVoidAsync("positionPopup", popup, button, 200);
            }
            await options.FocusAsync(true);
            await OnPopupReady.InvokeAsync(popup);
        }
        else if (!IsOpen || Mobile)
        {
            wasOpen = false;
        }
        if (FocusRequested || focusButton)
        {
            focusButton = false;
            await button.FocusAsync(true);
            if (FocusRequested)
            {
                await OnFocusHandled.InvokeAsync(TaskId);
            }
        }
    }

    private async Task ToggleAsync()
    {
        if (IsSaving)
        {
            return;
        }
        if (IsOpen)
        {
            await CloseAsync();
            return;
        }
        await OnOpen.InvokeAsync(TaskId);
    }

    private async Task OnButtonKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowDown" && !IsOpen && !IsSaving)
        {
            await OnOpen.InvokeAsync(TaskId);
        }
    }

    private async Task EscapeAsync()
    {
        focusButton = true;
        await CloseAsync();
    }

    private async Task ChooseAsync(string status)
    {
        if (!IsOpen)
        {
            return;
        }
        if (status == Condition)
        {
            focusButton = true;
            await CloseAsync();
            return;
        }
        await OnSelect.InvokeAsync((TaskId, status));
    }

    private async Task CloseAsync()
    {
        if (IsOpen)
        {
            await OnClose.InvokeAsync(TaskId);
        }
    }
}
