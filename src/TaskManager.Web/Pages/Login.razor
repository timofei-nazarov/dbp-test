@page "/login"
@layout LoginLayout
@inject UserSession Session
@inject NavigationManager Navigation

<main class="auth-page">
    <LoginForm @ref="form"
               @bind-Username="username"
               @bind-Password="password"
               @bind-PasswordVisible="passwordVisible"
               Busy="busy"
               Failed="failed"
               OnSubmit="SignInAsync" />
</main>

@code {
    private LoginForm? form;
    private string username = "";
    private string password = "";
    private bool passwordVisible;
    private bool busy;
    private bool failed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && form is not null)
        {
            await form.FocusUsernameAsync();
        }
    }

    private async Task SignInAsync()
    {
        if (busy)
        {
            return;
        }
        busy = true;
        failed = false;
        var signedIn = false;
        try
        {
            signedIn = await Session.SignInAsync(username, password);
        }
        catch (HttpRequestException)
        {
            signedIn = false;
        }
        busy = false;
        if (signedIn)
        {
            Navigation.NavigateTo("/board");
            return;
        }
        failed = true;
        password = "";
    }
}
